NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Use your Atlas connection string copied exactly from MongoDB Atlas.
# Format:
# MONGO_URI=mongodb+srv://olumayowajones_db_user:<your-password>@cluster0.<cluster-id>.mongodb.net/alumni_marketplace?retryWrites=true&w=majority
#
# The host must be the real one from Atlas. The old value using "cluster.mongodb.net"
# does not match the actual cluster hostname and causes the ENOTFOUND error.
MONGO_URI=mongodb+srv://olumayowajones_db_user:<your-password>@cluster0.<cluster-id>.mongodb.net/alumni_marketplace?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key

# Optional — leave empty to use local disk storage for uploads instead.
# If set, the upload middleware automatically switches to Cloudinary.
CLOUDINARY_URL=
