NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/alumni_marketplace
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key

# Optional — leave unset to use local disk storage for uploads instead.
# If set, the upload middleware automatically switches to Cloudinary.
CLOUDINARY_URL=cloudinary://replace_with_your_cloudinary_url
